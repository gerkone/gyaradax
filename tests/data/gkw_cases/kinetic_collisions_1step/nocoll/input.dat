/
&SPCGENERAL
 finit = "cosine"
 beta = 0.0,
 adiabatic_electrons = .false.
/
&SPECIES
 MASS  = 1.0,
 Z     = 1.0,
 TEMP  = 1.0,
 dens  = 1.0,
 rlt   = 3.72,
 rln   = 2.67,
 uprim = 0.0,
/
&SPECIES
 MASS  = 2.72e-4,
 Z     = -1.0,
 TEMP  = 0.903,
 dens  = 1.0,
 rlt   = 4.94,
 rln   = 2.67,
 uprim = 0.0,
/
&ROTATION
 VCOR = 0.0
/
&DIAGNOSTIC
 lcalc_freq = .false.
 lfinal_output = .false.
/
