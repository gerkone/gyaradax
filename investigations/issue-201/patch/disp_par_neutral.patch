new file mode 100644
index 0000000..a262b9f
--- /dev/null
+++ b/tests/unit/test_disp_par_neutral.py
@@ -0,0 +1,185 @@
+"""Charge-neutral parallel dissipation (``disp_par_neutral``)."""
+
+from dataclasses import replace
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+from omegaconf import OmegaConf
+
+from gyaradax.backends import create_ops
+from gyaradax.backends._jax import _PAR_TAP_HI, _PAR_TAP_LO, _StencilTable
+from gyaradax.core.jax_config import enable_x64
+from gyaradax.core.params import gkparams_from_config
+from gyaradax.geometry.geom import compute_geometry_from_config
+from gyaradax.operators.fields import _compute_fields
+from gyaradax.operators.precompute import linear_precompute
+from gyaradax.solver.eigenvalue import _slice_ky_geometry
+
+enable_x64()
+
+NS, NKX, NVPAR, NMU = 16, 3, 8, 4
+
+
+def _build(neutral: bool, kinetic: bool = True, disp_par: float = 1.0, end: int = 2, alpha: float = 0.0):
+    """Small electromagnetic chain with kinetic electrons, or its adiabatic-electron twin."""
+    one = (lambda a, b: [a, b]) if kinetic else (lambda a, b: a)
+    cfg = OmegaConf.create({
+        "run": {"name": "neutral"},
+        "solver": dict(dt=0.002, naverage=10, disp_par=disp_par, disp_vp=0.0, disp_x=0.0, disp_y=0.0,
+                       idisp=2, non_linear=False, adaptive_dt=False, finit="noise", n_steps=10,
+                       backend="jax", nlapar=kinetic, nlbpar=False, disp_par_neutral=neutral,
+                       disp_par_neutral_end=end, disp_par_neutral_alpha=alpha),
+        "physics": dict(rlt=one(6.2, 7.9), rln=one(5.4, 5.4), mas=one(1.0, 2.7232e-4),
+                        tmp=one(1.0, 0.9), de=one(1.0, 1.0), signz=one(1.0, -1.0), dgrid=1.0,
+                        tgrid=1.0, beta=0.0035 if kinetic else 0.0, betaprime=0.0),
+        "geometry": dict(geometry_model="circ", shat=2.357, q=3.1962, eps=0.253387),
+        "grid": dict(nvpar=NVPAR, nmu=NMU, ns=NS, nkx=NKX, nky=2, adiabatic_electrons=not kinetic,
+                     vpar_max=3.0, nperiod=1, krhomax=0.3, ikxspace=1),
+    })
+    params = gkparams_from_config(cfg, backend="jax", mixed_precision=False)
+    params = replace(params, non_linear=False)
+    geometry = compute_geometry_from_config(cfg)
+    pre = linear_precompute(geometry, params)
+    return params, geometry, pre, create_ops(pre, backend="jax", mixed_precision=False)
+
+
+def _noise(pre, kinetic: bool):
+    shape = ((2,) if kinetic else ()) + (NVPAR, NMU, NS, NKX, int(np.asarray(pre["ky_b"]).size))
+    k1, k2 = jax.random.split(jax.random.PRNGKey(0))
+    return jax.random.normal(k1, shape) + 1j * jax.random.normal(k2, shape)
+
+
+def _plain_dissipation(x, pre, ops):
+    tab = _StencilTable(pre["s_disp_neutral_tab"], ops.pre["par_stencil_class"])
+    ky_idx = jnp.reshape(jnp.arange(x.shape[-1], dtype=jnp.int32), (1, 1, -1))
+    d = jnp.zeros_like(x)
+    for i in range(_PAR_TAP_LO, _PAR_TAP_HI):
+        shifted = x[..., ops.pre["s_shift"][i], ops.pre["kx_shift"][i], ky_idx]
+        d = d + tab[i] * jnp.where(ops.pre["valid_shift"][i], shifted, 0.0)
+    return d
+
+
+def _rhs(ops, f, geometry, params, pre):
+    phi, apar, bpar = _compute_fields(f, geometry, params, pre)[:3]
+    return ops.linear_rhs(f, phi, geometry, params, pre, apar=apar, bpar=bpar)
+
+
+def test_default_is_off():
+    params, _, pre, _ = _build(False)
+    assert params.disp_par_neutral is False
+    assert "dneu_w" not in pre
+
+
+@pytest.mark.parametrize("kinetic", [True, False])
+def test_charge_of_the_dissipation(kinetic):
+    """The dissipation's charge is that of the dissipated charge-carrying part, away from open ends."""
+    params, geometry, pre, ops = _build(True, kinetic)
+    p0, g0, pre0, ops0 = _build(False, kinetic)
+    f = _noise(pre, kinetic)
+    axes = tuple(range(f.ndim - 3))
+    w, e_in, e_out = pre["dneu_w"], pre["dneu_ein"], pre["dneu_eout"]
+
+    def rho(x):
+        return jnp.sum(w * x, axis=axes)
+
+    term = _rhs(ops, f, geometry, params, pre) - _rhs(ops0, f, g0, p0, pre0)
+    pf = e_in * jnp.sum(w * f, axis=axes, keepdims=True)
+    inner = np.asarray(jnp.sum(e_out, axis=axes) != 0.0)
+    assert inner.any() and not inner[:, :, 1:].all()
+    got = np.asarray(rho(_plain_dissipation(f, pre, ops) + term))
+    want = np.asarray(rho(_plain_dissipation(pf, pre, ops)))
+    scale = np.abs(np.asarray(rho(_plain_dissipation(f, pre, ops)))).max()
+    assert np.abs(got - want)[inner].max() < 1e-10 * scale
+    # the two points next to an open end keep the plain rows
+    assert np.abs(np.asarray(term))[..., ~inner].max() == 0.0
+    assert np.abs(np.asarray(term)).max() > 1e-6 * scale
+
+
+def test_charge_carrying_part_is_untouched():
+    """A distribution of the charge-carrying shape sees the plain dissipation."""
+    params, geometry, pre, ops = _build(True)
+    p0, g0, pre0, ops0 = _build(False)
+    f = _noise(pre, True)
+    pf = pre["dneu_ein"] * jnp.sum(pre["dneu_w"] * f, axis=(0, 1, 2), keepdims=True)
+    a = np.asarray(_rhs(ops, pf, geometry, params, pre))
+    b = np.asarray(_rhs(ops0, pf, g0, p0, pre0))
+    assert np.abs(a - b).max() < 1e-10 * np.abs(b).max()
+
