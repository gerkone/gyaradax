+def test_end_width_option():
+    """``disp_par_neutral_end`` sets how many points next to an open end keep the plain rows."""
+    params, _, pre, _ = _build(True)
+    _, _, wide, _ = _build(True, end=4)
+    off2 = np.asarray(jnp.sum(pre["dneu_eout"], axis=(0, 1, 2)) == 0.0)
+    off4 = np.asarray(jnp.sum(wide["dneu_eout"], axis=(0, 1, 2)) == 0.0)
+    assert params.disp_par_neutral_end == 2
+    assert off2[:2].any() and not off2[2:NS - 2].any()
+    assert off4[:4].any() and not off4[4:NS - 4].any()
+    assert (off4 | ~off2).all() and off4.sum() == 2 * off2.sum()
