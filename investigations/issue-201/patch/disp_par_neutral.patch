+def test_alpha_limit():
+    """``disp_par_neutral_alpha`` keeps the projection where the skin term of Ampere's law is large."""
+    _, _, pre, _ = _build(True, alpha=10.0)
+    _, _, full, _ = _build(True)
+    k2 = pre["kperp_sq"].reshape(pre["apar_diag"].shape)
+    inside = np.asarray(pre["apar_diag"] - k2 > 10.0 * k2)
+    on = np.asarray(jnp.sum(jnp.abs(pre["dneu_eout"]), axis=(0, 1, 2)) > 0)
+    on_full = np.asarray(jnp.sum(jnp.abs(full["dneu_eout"]), axis=(0, 1, 2)) > 0)
+    assert (on == (on_full & inside)).all()
+    assert 0 < on.sum() < on_full.sum()
+    # electrostatic runs keep the plain rows
+    assert "dneu_w" not in _build(True, kinetic=False, alpha=10.0)[2]
