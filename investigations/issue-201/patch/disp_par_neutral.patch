+def _neutral_on(params) -> bool:
+    # with an alpha limit the option needs A_par; electrostatic runs keep the plain rows
+    return params.disp_par_neutral and (params.nlapar or params.disp_par_neutral_alpha <= 0.0)
+
+
+def _disp_neutral_tables(geometry, params, sp, s_disp_tab, bn, kinetic):
+    """Tables of the charge-neutral parallel dissipation ``params.disp_par_neutral``.
+
+    With ``D`` the plain parallel dissipation (``s_disp_neutral_tab``), ``u = (Z / T) J0 F_M``
+    and the gyro-averaged charge ``rho[x] = sum_species sum_v w x``, the right-hand side
+    gains ``-e_out rho[D[f - e_in rho[f]]]``. ``e_in = u / rho[u]``; ``e_out`` equals
+    ``e_in`` except at the ``disp_par_neutral_end`` points next to an open chain end,
+    where it is zero.
+
+    Args:
+        geometry: Holds ``intmu``, ``intvp``, ``ixminus`` and ``ixplus``.
+        params: Run parameters (``signz``, ``tmp``, ``de``, ``disp_par_neutral_end``).
+        sp: Species tables with ``bessel`` and ``fmaxwl``.
+        s_disp_tab: Stencil table of the plain parallel dissipation.
+        bn: Magnetic field strength along ``s``.
+        kinetic: True for 6D tables with a leading species axis.
+
+    Returns:
+        Dict with ``s_disp_neutral_tab``, ``dneu_w``, ``dneu_ein`` and ``dneu_eout``.
+    """
+    lead = (1,) if kinetic else ()
+
+    def col(x):
+        x = jnp.atleast_1d(jnp.asarray(x, dtype=jnp.float64))
+        return x.reshape((-1, 1, 1, 1, 1, 1)) if kinetic else x[0]
+
+    z, tmp, de = col(params.signz), col(params.tmp), col(params.de)
+    intmu_p = jnp.asarray(geometry["intmu"], dtype=jnp.float64).reshape(lead + (1, -1, 1, 1, 1))
+    intvp_p = jnp.asarray(geometry["intvp"], dtype=jnp.float64).reshape(lead + (-1, 1, 1, 1, 1))
+    bn_p = jnp.reshape(bn, lead + (1, 1, -1, 1, 1))
+    bes, fm = sp["bessel"], sp["fmaxwl"]
+    w = z * de * bn_p * intmu_p * intvp_p * bes
+    u = z / tmp * bes * fm
+    axes = (0, 1, 2) if kinetic else (0, 1)
+    e_in = u / jnp.maximum(jnp.sum(w * u, axis=axes, keepdims=True), EPS)
+    ns = int(bn_p.shape[-3])
+    s_i = jnp.arange(ns).reshape(-1, 1, 1)
+    left = jnp.asarray(geometry["ixminus"])[None] < 0
+    right = jnp.asarray(geometry["ixplus"])[None] < 0
+    n_end = int(params.disp_par_neutral_end)
+    near = (left & (s_i < n_end)) | (right & (s_i >= ns - n_end))
+    e_out = e_in * jnp.where(near, 0.0, 1.0)
+    return {"s_disp_neutral_tab": s_disp_tab, "dneu_w": w, "dneu_ein": e_in, "dneu_eout": e_out}
+
