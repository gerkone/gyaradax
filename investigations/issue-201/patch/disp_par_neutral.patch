+def disp_neutral_term(f: jnp.ndarray, pre, maps) -> jnp.ndarray:
+    """Term of ``disp_par_neutral``: ``-e_out rho[D[f - e_in rho[f]]]``.
+
+    ``D`` is the plain parallel dissipation and ``rho`` the gyro-averaged charge, summed
+    over velocity space and, for a 6D ``f``, over species.
+
+    Args:
+        f: Physical distribution, (nv, nmu, ns, nkx, nky) with an optional leading species axis.
+        pre: Holds ``s_disp_neutral_tab``, ``dneu_w``, ``dneu_ein`` and ``dneu_eout``.
+        maps: Holds ``s_shift``, ``kx_shift``, ``valid_shift`` and ``par_stencil_class``.
+
+    Returns:
+        The term, same shape as ``f``.
+    """
+    axes = tuple(range(f.ndim - 3))
+    w = pre["dneu_w"]
+    x = f if "dneu_f1" in pre else f - pre["dneu_ein"] * jnp.sum(w * f, axis=axes, keepdims=True)
+    tab = _StencilTable(pre["s_disp_neutral_tab"], maps["par_stencil_class"])
+    ky_idx = jnp.reshape(jnp.arange(f.shape[-1], dtype=jnp.int32), (1, 1, -1))
+    d = jnp.zeros_like(f)
+    for i in range(_PAR_TAP_LO, _PAR_TAP_HI):
+        shifted = x[..., maps["s_shift"][i], maps["kx_shift"][i], ky_idx]
+        d = d + _mul_real(tab[i], jnp.where(maps["valid_shift"][i], shifted, 0.0))
+    return -pre["dneu_eout"] * jnp.sum(w * d, axis=axes, keepdims=True)
+
