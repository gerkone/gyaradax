+def _chain_spectrum(neutral: bool):
+    """Dense spectrum of a three-kx electromagnetic chain at finite theta0 (test grid, 16 x 8 x 2)."""
+    ns, nkx, nvpar, nmu = 16, 3, 8, 2
+    cfg = OmegaConf.create({
+        "run": {"name": "chain"},
+        "solver": dict(dt=0.002, naverage=10, disp_par=2.0, disp_vp=0.0, disp_x=0.0, disp_y=0.0,
+                       idisp=2, non_linear=False, adaptive_dt=False, finit="noise", n_steps=10,
+                       backend="jax", nlapar=True, nlbpar=False, disp_par_neutral=neutral),
+        "physics": dict(rlt=[6.2, 7.9], rln=[5.4, 5.4], mas=[1.0, 2.7232e-4], tmp=[1.0, 0.9],
+                        de=[1.0, 1.0], signz=[1.0, -1.0], dgrid=1.0, tgrid=1.0, beta=0.0035,
+                        betaprime=0.0),
+        "geometry": dict(geometry_model="circ", shat=2.357, q=3.1962, eps=0.253387),
+        "grid": dict(nvpar=nvpar, nmu=nmu, ns=ns, nkx=nkx, nky=2, adiabatic_electrons=False,
+                     vpar_max=3.0, nperiod=1, krhomax=0.07, ikxspace=1),
+    })
+    params = gkparams_from_config(cfg, backend="jax", mixed_precision=False)
+    params = replace(params, non_linear=False)
+    geometry = compute_geometry_from_config(cfg)
+    geometry["kxrh"] = geometry["kxrh"] - 0.304404
+    geometry = _slice_ky_geometry(geometry, 1)
+    pre = linear_precompute(geometry, params)
+    ops = create_ops(pre, backend="jax", mixed_precision=False)
+    shape = (2, nvpar, nmu, ns, nkx, 1)
+
+    def rhs(v):
+        g = v.reshape(shape)
+        phi, apar, bpar = ops.compute_fields(g, geometry, params, pre)
+        out = ops.linear_rhs_from_g(g, phi, geometry, params, pre, apar=apar, bpar=bpar)
+        return out.reshape(-1)
+
+    n = int(np.prod(shape))
+    mat = jax.lax.map(rhs, jnp.eye(n, dtype=jnp.complex128), batch_size=256).T
+    return np.linalg.eigvals(np.asarray(mat))
+
+
+def test_fast_mode_is_removed():
+    """The grid-scale electromagnetic mode of the plain scheme is gone; the smooth mode stays."""
+    plain = _chain_spectrum(False)
+    neutral = _chain_spectrum(True)
+    smooth = plain[np.abs(plain.imag) < 5.0].real.max()
+    assert plain.real.max() > 1.0
+    assert neutral.real.max() < 0.2
+    assert abs(neutral.real.max() - smooth) < 0.1 * smooth
