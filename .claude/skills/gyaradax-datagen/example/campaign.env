# sourced by worker.sh: interpreter, gyaradax checkout, run flags and dataset root of this campaign
PY=/path/to/python
REPO=/path/to/gyaradax
DATASET=/path/to/preprocessed/kinetic/ex1
# hopper (H100, H200): fused linear only; blackwell B300: add double-single linear arithmetic and the fused bracket
FLAGS="--backend cuda --mp --fused-linear --snapshot-every 10 --stop-on-banding"
case $(nvidia-smi -i "$G" --query-gpu=name --format=csv,noheader 2>/dev/null) in *B300*) FLAGS="$FLAGS --linear-arith ds --fused-bracket" ;; esac
# adiabatic runs as the stored adiabatic set: unrounded fp32 df frames
# FLAGS="$FLAGS --dataset-bits f32"
export LD_PRELOAD=${LD_PRELOAD:-}
